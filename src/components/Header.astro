---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { getContent, type SiteContent } from '@/content-data';
import { tinaField } from '@tinacms/astro/tina-field';
import { sanitizeImageSrc } from '@tinacms/astro/sanitize';
import { oppositeLocale, pathFor, type Locale, type PageKey } from '@/lib/routes';

interface Props {
  locale: Locale;
  page: PageKey;
  content?: SiteContent;
}

const { locale, page, content: suppliedContent } = Astro.props;
const content = suppliedContent ?? getContent(locale);
const itemFor = (key: PageKey) => content.navigation.items.find((item) => item.page === key);
const labelFor = (key: PageKey) => itemFor(key)?.label ?? key;
const editableField = (source: unknown, field: string) => tinaField(source as Record<string, unknown> | undefined, field) || undefined;
const settingsSource = content._tina?.settings as Record<string, any> | undefined;
const navigationSource = settingsSource?.navigation as Record<string, any> | undefined;
const navigationSourceFor = (key: PageKey) => navigationSource?.items?.find((item: Record<string, unknown>) => item?.page === key);
const localizedField = (source: unknown) => editableField(source, locale);
const logoSrc = sanitizeImageSrc(content.brand.primaryLogo ?? '/brand/lab-mark-original-transparent-optimized.webp') || '/brand/lab-mark-original-transparent-optimized.webp';
const otherLocale = oppositeLocale(locale);
const primary: PageKey[] = ['research', 'techniques', 'publications', 'team'];
const secondary: PageKey[] = ['philosophy', 'outreach'];
---

<header class:list={['site-header', page === 'home' && 'is-home']} data-site-header>
  <div class="header-inner shell">
    <a class="brand-link" href={pathFor(locale, 'home')} aria-label={`${content.brand.name} · ${content.common.backToHome}`}>
      <span class="brand-mark" aria-hidden="true">
        <img class="brand-mark-color" src={logoSrc} width="384" height="345" alt="" data-tina-field={editableField(settingsSource?.brand, 'primaryLogo')} />
        <img class="brand-mark-contrast" src={logoSrc} width="384" height="345" alt="" />
      </span>
      <span class="brand-name">
        <strong data-tina-field={localizedField(settingsSource?.brand?.name)}>{content.brand.name}</strong>
        <small data-tina-field={localizedField(settingsSource?.brand?.scientificName)}>{content.brand.scientificName}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={content.navigation.ariaLabel}>
      {primary.map((item) => {
        return <a href={pathFor(locale, item)} aria-current={page === item ? 'page' : undefined} data-tina-field={localizedField(navigationSourceFor(item)?.label)}>{labelFor(item)}</a>;
      })}
      <details class="nav-more">
        <summary class:list={[secondary.includes(page) && 'is-active']}>{content.navigation.laboratoryMenuLabel}</summary>
        <div class="nav-popover">
          {secondary.map((item) => {
            return <a href={pathFor(locale, item)} aria-current={page === item ? 'page' : undefined} data-tina-field={localizedField(navigationSourceFor(item)?.label)}>{labelFor(item)}</a>;
          })}
        </div>
      </details>
      <a class="nav-contact" href={pathFor(locale, 'contact')} aria-current={page === 'contact' ? 'page' : undefined} data-tina-field={localizedField(navigationSourceFor('contact')?.label)}>{labelFor('contact')}</a>
      <ThemeToggle {locale} />
      <a class="lang-link" href={pathFor(otherLocale, page)} lang={otherLocale} hreflang={otherLocale} aria-label={`${content.navigation.languageSwitcherLabel}: ${content.alternateLanguageLabel}`}>
        {otherLocale.toUpperCase()}
      </a>
    </nav>

    <div class="mobile-actions">
      <ThemeToggle {locale} />
      <a class="lang-link" href={pathFor(otherLocale, page)} lang={otherLocale} hreflang={otherLocale} aria-label={`${content.navigation.languageSwitcherLabel}: ${content.alternateLanguageLabel}`}>{otherLocale.toUpperCase()}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-open-label={content.navigation.openMenuLabel} data-close-label={content.navigation.closeMenuLabel}>
        <span class="sr-only">{content.navigation.openMenuLabel}</span>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label={content.navigation.ariaLabel} hidden>
    <div class="shell mobile-menu-inner">
      {(['research', 'techniques', 'publications', 'team', 'philosophy', 'outreach', 'contact'] as PageKey[]).map((item) => (
        <a href={pathFor(locale, item)} aria-current={page === item ? 'page' : undefined} data-tina-field={localizedField(navigationSourceFor(item)?.label)}>
          {labelFor(item)}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .brand-link {
    display: flex;
    width: auto;
    align-items: center;
    gap: 14px;
  }

  .brand-mark {
    position: relative;
    display: block;
    width: 72px;
    height: 65px;
    flex: 0 0 72px;
  }

  .brand-link .brand-mark :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 180ms cubic-bezier(.25, 1, .5, 1);
  }

  .brand-mark-color { opacity: 1; }
  .brand-mark-contrast {
    opacity: 0;
    filter: brightness(0) invert(1);
  }

  :global(:root[data-theme='dark']) .brand-mark-color { opacity: 0; }
  :global(:root[data-theme='dark']) .brand-mark-contrast { opacity: .96; }

  .site-header.is-home .brand-mark-color { opacity: var(--header-transition-progress); }
  .site-header.is-home .brand-mark-contrast { opacity: calc(1 - var(--header-transition-progress)); }

  :global(:root[data-theme='dark']) .site-header.is-home .brand-mark-color { opacity: 0; }
  :global(:root[data-theme='dark']) .site-header.is-home .brand-mark-contrast { opacity: .96; }

  @media (prefers-reduced-motion: reduce) {
    .brand-link .brand-mark :global(img) { transition: none; }
  }

  .brand-name {
    display: block;
    min-width: 0;
    color: var(--ink);
    line-height: 1.1;
  }

  .brand-name strong {
    display: block;
    font-size: 1.12rem;
    font-weight: 720;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .brand-name small {
    display: block;
    margin-top: 3px;
    font-family: var(--font-body);
    font-size: 0.63rem;
    font-weight: 650;
    letter-spacing: 0.045em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .brand-link { gap: 13px; }
    .brand-mark { width: 64px; height: 58px; flex-basis: 64px; }
    .brand-name strong { font-size: 1.08rem; }
    .brand-name small { font-size: 0.61rem; }
  }

  @media (max-width: 760px) {
    .brand-link { gap: 12px; }
    .brand-mark { width: 58px; height: 52px; flex-basis: 58px; }
    .brand-name strong { font-size: 1.02rem; }
    .brand-name small { font-size: 0.56rem; }
  }

  @media (max-width: 560px) {
    .brand-link { gap: 10px; }
    .brand-mark { width: 52px; height: 47px; flex-basis: 52px; }
    .brand-name strong { font-size: 0.96rem; }
    .brand-name small { display: none; }
  }

  @media (max-width: 360px) {
    .brand-link { gap: 8px; }
    .brand-mark { width: 40px; height: 36px; flex-basis: 40px; }
    .brand-name strong { font-size: 0.85rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = header?.querySelector<HTMLElement>('#mobile-menu');

  let lastHeaderProgress = -1;

  const syncHomeHeader = () => {
    if (!header?.classList.contains('is-home')) return;

    const transitionDistance = 240;
    const position = Math.min(Math.max(window.scrollY / transitionDistance, 0), 1);
    const progress = position * position * (3 - 2 * position);
    if (Math.abs(progress - lastHeaderProgress) < 0.0005) return;
    lastHeaderProgress = progress;

    header.style.setProperty('--header-surface', `${4 + (84 * progress)}%`);
    header.style.setProperty('--header-transition-progress', String(progress));
    header.style.setProperty('--header-foreground', `${(1 - progress) * 100}%`);
    header.style.setProperty('--header-border-opacity', `${progress * 100}%`);
    header.style.setProperty('--header-blur', `${16 * progress}px`);
    header.style.setProperty('--header-saturation', `${100 + (30 * progress)}%`);
  };

  let headerFrame = 0;
  const requestHeaderSync = () => {
    if (headerFrame) return;
    headerFrame = window.requestAnimationFrame(() => {
      syncHomeHeader();
      headerFrame = 0;
    });
  };

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    const label = toggle.querySelector<HTMLElement>('.sr-only');
    if (label) label.textContent = open ? (toggle.dataset.closeLabel ?? label.textContent) : (toggle.dataset.openLabel ?? label.textContent);
    menu.hidden = !open;
    header?.classList.toggle('menu-open', open);
    document.documentElement.classList.toggle('menu-is-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1181) setOpen(false);
    requestHeaderSync();
  });
  window.addEventListener('scroll', requestHeaderSync, { passive: true });
  syncHomeHeader();
</script>
