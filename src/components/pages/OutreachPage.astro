---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BodyOnlyLayout from '@/layouts/BodyOnlyLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { getContent, type Locale, type SiteContent } from '@/content-data';
import { blockAttributes } from '@/lib/cms/layout';
import { getPublishedOutreachEntries, outreachEntryPath } from '@/lib/outreach';
import { pathFor } from '@/lib/routes';

interface Props { locale: Locale; content?: SiteContent; embedded?: boolean }
const { locale, content: suppliedContent, embedded = false } = Astro.props;
const content = suppliedContent ?? getContent(locale);
const Layout = embedded ? BodyOnlyLayout : BaseLayout;
const copy = content.outreach;
const heroBlock = blockAttributes(content, 'outreach', 'hero', 1);
const feedBlock = blockAttributes(content, 'outreach', 'outreachFeed', 2);
const statusBlock = blockAttributes(content, 'outreach', 'status', 3);
const entries = await getPublishedOutreachEntries(locale);
const archive = copy.archive;
const publishedEntryCount = entries.length === 1
  ? archive.publishedEntrySingular
  : archive.publishedEntryPlural.replace('{count}', String(entries.length));
const typeLabels = {
  article: archive.articleLabel,
  event: archive.eventLabel,
  resource: archive.resourceLabel,
};
const formatDate = (date: Date) => new Intl.DateTimeFormat(locale === 'es' ? 'es-CL' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<Layout locale={locale} page="outreach" title={content.seo.outreach.title} description={content.seo.outreach.description} content={content}>
  <PageHero
    index="06"
    eyebrow={copy.eyebrow}
    title={copy.title}
    introduction={copy.introduction}
    source={copy}
    asideLabel={entries.length > 0 ? archive.eyebrow : archive.comingSoonLabel}
    asideText={entries.length > 0 ? publishedEntryCount : archive.emptyAsideText}
    block={heroBlock}
  />

  {entries.length > 0 ? (
    <section class="content-section paper-band outreach-feed" {...feedBlock}>
      <div class="shell">
        <header class="section-heading outreach-feed-heading">
          <div data-reveal>
            <span class="eyebrow">{archive.eyebrow}</span>
            <h2 class="section-title">{archive.title}</h2>
          </div>
          <p class="lead" data-reveal data-reveal-delay="1">{archive.introduction}</p>
        </header>

        <ol class="outreach-register">
          {entries.map((entry, index) => (
            <li data-reveal data-reveal-delay={String(Math.min(index, 2))}>
              <div class="outreach-entry-meta">
                <span>{typeLabels[entry.data.type]}</span>
                <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>
              </div>
              <div class="outreach-entry-copy">
                <h3><a href={outreachEntryPath(locale, entry.data.slug)}>{entry.data.title}</a></h3>
                <p>{entry.data.summary}</p>
              </div>
              <a class="outreach-entry-link" href={outreachEntryPath(locale, entry.data.slug)} aria-label={`${archive.readLabel}: ${entry.data.title}`}>
                <span>{archive.readLabel}</span><i aria-hidden="true">→</i>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ) : (
    <section class="status-stage paper-band" {...statusBlock}>
      <div class="status-content" data-reveal>
        <span class="eyebrow">{content.common.stateLabels[copy.status]}</span>
        <h2>{copy.statusTitle}</h2>
        <p>{copy.statusText}</p>
        <div class="hero-actions">
          <a class="button" href={pathFor(locale, copy.statusPrimaryAction.page)}>{copy.statusPrimaryAction.label}<span aria-hidden="true">→</span></a>
          <a class="button secondary" href={pathFor(locale, copy.statusSecondaryAction.page)}>{copy.statusSecondaryAction.label}</a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .outreach-feed-heading { margin-bottom: clamp(42px, 6vw, 72px); }

  .outreach-register {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .outreach-register li {
    display: grid;
    grid-template-columns: minmax(150px, .34fr) minmax(0, 1.4fr) minmax(110px, .26fr);
    gap: clamp(24px, 4vw, 58px);
    align-items: start;
    padding: clamp(28px, 4vw, 44px) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .outreach-entry-meta {
    display: grid;
    gap: 7px;
    padding-top: 4px;
    color: var(--ink-3);
    font-size: .8rem;
  }

  .outreach-entry-meta span { color: var(--teal-dark); font-weight: 700; }
  .outreach-entry-copy h3 { margin-bottom: 10px; font-size: clamp(1.35rem, 2vw, 1.9rem); line-height: 1.18; }
  .outreach-entry-copy h3 a { text-decoration: none; }
  .outreach-entry-copy h3 a:hover { color: var(--teal-dark); }
  .outreach-entry-copy p { max-width: 70ch; color: var(--ink-2); }

  .outreach-entry-link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    padding-top: 5px;
    font-size: .88rem;
    font-weight: 680;
    text-decoration: none;
  }

  .outreach-entry-link i {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-style: normal;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .outreach-entry-link:hover { color: var(--teal-dark); }
  .outreach-entry-link:hover i { transform: translateX(3px); border-color: var(--teal-dark); }

  @media (max-width: 820px) {
    .outreach-register li { grid-template-columns: 130px minmax(0, 1fr); }
    .outreach-entry-link { grid-column: 2; justify-content: flex-start; }
  }

  @media (max-width: 560px) {
    .outreach-register li { grid-template-columns: 1fr; gap: 16px; }
    .outreach-entry-meta { grid-template-columns: auto 1fr; }
    .outreach-entry-link { grid-column: 1; }
  }
</style>
