---
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BodyOnlyLayout from '@/layouts/BodyOnlyLayout.astro';
import { getContent, type Locale, type SiteContent } from '@/content-data';
import { blockAttributes } from '@/lib/cms/layout';
import { resolveMediaAsset } from '@/lib/media';
import { featuredPublicationWorks, preferredPublicationUrl } from '@/lib/publications';
import { pathFor } from '@/lib/routes';

interface Props { locale: Locale; content?: SiteContent; embedded?: boolean }
const { locale, content: suppliedContent, embedded = false } = Astro.props;
const content = suppliedContent ?? getContent(locale);
const Layout = embedded ? BodyOnlyLayout : BaseLayout;
const copy = content.home;
const editableField = (source: unknown, field: string) => tinaField(source as Record<string, unknown> | undefined, field) || undefined;
const researchHref = pathFor(locale, 'research');
const featuredPublications = featuredPublicationWorks(3);
const heroBlock = blockAttributes(content, 'home', 'hero', 1);
const publicEntryBlock = blockAttributes(content, 'home', 'publicEntry', 2);
const researchBlock = blockAttributes(content, 'home', 'researchPreview', 3);
const imageRegisterBlock = blockAttributes(content, 'home', 'imageRegister', 4);
const techniquesBlock = blockAttributes(content, 'home', 'techniquesPreview', 5);
const fundingBlock = blockAttributes(content, 'home', 'fundingPreview', 6);
const publicationsBlock = blockAttributes(content, 'home', 'publicationsPreview', 7);
const teamBlock = blockAttributes(content, 'home', 'teamPreview', 8);
const joinBlock = blockAttributes(content, 'home', 'callToAction', 9);

const resolveImage = (reference: unknown, allowedKinds: readonly ('micrograph' | 'photograph' | 'figure')[]) => {
  const asset = resolveMediaAsset(reference, { locale, allowedKinds });
  if (asset.type !== 'image') throw new Error(`El medio «${asset.id}» no es una imagen.`);
  return asset;
};
const heroMedia = resolveImage(copy.media.hero, ['micrograph', 'photograph', 'figure']);
const registerMedia = [
  resolveImage(copy.media.registerOne, ['micrograph', 'figure']),
  resolveImage(copy.media.registerTwo, ['micrograph', 'figure']),
  resolveImage(copy.media.registerThree, ['micrograph', 'figure']),
];
const teamEstebanMedia = resolveImage(copy.media.teamEsteban, ['photograph']);
const teamSinayMedia = resolveImage(copy.media.teamSinay, ['photograph']);

const imageRegister = copy.imageRegister;

const publicationAuthors = (authors: readonly string[]) => {
  if (authors.length <= 3) return authors.join(', ');
  return `${authors.slice(0, 2).join(', ')} ${copy.publicationAuthorsContinuation}`;
};
---

<Layout locale={locale} page="home" title={content.seo.home.title} description={content.seo.home.description} content={content}>
  <section class="home-hero" {...heroBlock}>
    <div class="home-hero-copy">
      <span class="eyebrow" data-tina-field={editableField(copy, 'eyebrow')}>{copy.eyebrow}</span>
      <h1 class="display-title" data-tina-field={editableField(copy, 'title')}>{copy.title}</h1>
      <p class="lead" data-tina-field={editableField(copy, 'introduction')}>{copy.introduction}</p>
      <nav class="hero-actions" aria-label={copy.heroActionsLabel}>
        <a class="text-link" href={pathFor(locale, copy.primaryAction.page)} data-tina-field={editableField(copy.primaryAction, 'label')}>{copy.primaryAction.label}<span aria-hidden="true">→</span></a>
        <a class="text-link" href={pathFor(locale, copy.secondaryAction.page)} data-tina-field={editableField(copy.secondaryAction, 'label')}>{copy.secondaryAction.label}<span aria-hidden="true">→</span></a>
      </nav>
      <dl class="hero-facts">
        {copy.heroFacts.map((fact) => (
          <div>
            <dt data-tina-field={editableField(fact, 'label')}>{fact.label}</dt>
            <dd data-tina-field={editableField(fact, 'value')}>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <p class="hero-affiliation">
        <span data-tina-field={editableField(copy, 'affiliation')}>{copy.affiliation}</span>
        <span data-tina-field={editableField(copy, 'location')}>{copy.location}</span>
      </p>
    </div>
    <figure class="hero-science">
      <Image src={heroMedia.image} alt={copy.heroImageAlt || heroMedia.alt} widths={[640, 900, 1024]} sizes="100vw" format="webp" quality={74} loading="eager" decoding="async" fetchpriority="high" style={`object-position: ${heroMedia.objectPosition}`} />
      <figcaption class="science-caption" data-tina-field={editableField(copy, 'heroImageCaption')}>{copy.heroImageCaption}</figcaption>
    </figure>
  </section>

  <section class="public-entry" id="por-que-importa" aria-labelledby="public-entry-title" {...publicEntryBlock}>
    <div class="shell">
      <div class="public-entry-overview">
        <header class="public-entry-heading" data-reveal>
          <span class="eyebrow" data-tina-field={editableField(copy.publicEntry, 'eyebrow')}>{copy.publicEntry.eyebrow}</span>
          <h2 id="public-entry-title" data-tina-field={editableField(copy.publicEntry, 'title')}>{copy.publicEntry.title}</h2>
          <p data-tina-field={editableField(copy.publicEntry, 'introduction')}>{copy.publicEntry.introduction}</p>
        </header>

        <div class="public-entry-narrative" data-reveal data-reveal-delay="1">
          <div data-tina-field={editableField(copy.publicEntry, 'body')}>{copy.publicEntry.body.map((paragraph) => <p>{paragraph}</p>)}</div>
          <div class="public-entry-question">
            <span>{copy.publicEntry.questionLabel}</span>
            <p>{copy.publicEntry.question}</p>
          </div>
        </div>
      </div>

      <div class="public-entry-register">
        <div class="public-entry-concepts" data-reveal>
          <p class="public-entry-register-label">{copy.publicEntry.glossaryLabel}</p>
          <dl>
            {copy.publicEntry.glossary.map((item) => (
              <div>
                <dt>{item.term}</dt>
                <dd>{item.definition}</dd>
              </div>
            ))}
          </dl>
        </div>

        <aside class="public-entry-scope" aria-label={copy.publicEntry.scopeLabel} data-reveal data-reveal-delay="1">
          <span>{copy.publicEntry.scopeLabel}</span>
          <p>{copy.publicEntry.scope}</p>
        </aside>
      </div>

      <nav class="public-entry-paths" aria-label={copy.publicEntry.linksLabel} data-reveal>
        <p>{copy.publicEntry.linksLabel}</p>
        <div>
          {copy.publicEntry.links.map((link) => (
            <a class="text-link" href={pathFor(locale, link.page)}>
              {link.label}<span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>

  <section class="content-section" {...researchBlock}>
    <div class="shell">
      <div class="section-heading">
        <div data-reveal>
          <span class="eyebrow">{copy.researchEyebrow}</span>
          <h2 class="section-title">{copy.researchTitle}</h2>
        </div>
        <p class="lead" data-reveal data-reveal-delay="1">{copy.researchIntroduction}</p>
      </div>
      <div class="research-question-list">
        {copy.researchAreas.map((area, index) => (
          <article class="research-question-row" data-reveal data-reveal-delay={String(Math.min(index, 2))}>
            <span class="number" aria-hidden="true">{area.number}</span>
            <div>
              <p class="research-status">{area.status}</p>
              <h3>{area.question}</h3>
              <p>{area.summary}</p>
            </div>
            <a class="text-link" href={`${researchHref}#${area.id}`} aria-label={`${content.common.learnMore}: ${area.title}`}><span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="lab-image-register" aria-labelledby="image-register-title" {...imageRegisterBlock}>
    <div class="shell">
      <header class="image-register-heading">
        <div data-reveal>
          <p class="image-register-index" data-tina-field={editableField(imageRegister, 'label')}>{imageRegister.label}</p>
          <h2 id="image-register-title" data-tina-field={editableField(imageRegister, 'title')}>{imageRegister.title}</h2>
        </div>
        <div class="image-register-context" data-reveal data-reveal-delay="1">
          <p data-tina-field={editableField(imageRegister, 'introduction')}>{imageRegister.introduction}</p>
          <dl>
            <div><dt data-tina-field={editableField(imageRegister, 'statusLabel')}>{imageRegister.statusLabel}</dt><dd data-tina-field={editableField(imageRegister, 'status')}>{imageRegister.status}</dd></div>
            <div><dt data-tina-field={editableField(imageRegister, 'criterionLabel')}>{imageRegister.criterionLabel}</dt><dd data-tina-field={editableField(imageRegister, 'criterion')}>{imageRegister.criterion}</dd></div>
          </dl>
        </div>
      </header>

      <div class="image-register-grid">
        {imageRegister.figures.map((figure, index) => (
          <figure class="image-register-entry" data-reveal data-reveal-delay={String(Math.min(index, 2))}>
            <div class="image-register-media">
              <Image src={registerMedia[index]!.image} alt={figure.alt || registerMedia[index]!.alt} widths={[360, 480, 760, 900]} sizes={index === 0 ? '(max-width: 760px) calc(100vw - 36px), min(56vw, 760px)' : '(max-width: 760px) calc(100vw - 36px), min(31vw, 480px)'} format="webp" quality={74} loading="lazy" decoding="async" style={`object-position: ${registerMedia[index]!.objectPosition}`} />
              <span aria-hidden="true" data-tina-field={editableField(figure, 'code')}>{figure.code}</span>
            </div>
            <figcaption><strong data-tina-field={editableField(figure, 'title')}>{figure.title}</strong><span data-tina-field={editableField(figure, 'note')}>{figure.note}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section paper-band" {...techniquesBlock}>
    <div class="shell pipeline-preview">
      <div data-reveal>
        <span class="eyebrow">{copy.pipelineEyebrow}</span>
        <h2 class="section-title">{copy.pipelineTitle}</h2>
        <p class="lead">{copy.pipelineIntroduction}</p>
        <a class="text-link" href={pathFor(locale, 'techniques')} style="margin-top: 30px">{content.navigation.items.find((item) => item.page === 'techniques')?.label}<span aria-hidden="true">→</span></a>
      </div>
      <ol class="method-register" aria-label={copy.pipelineTitle} data-reveal data-reveal-delay="1">
        {content.techniques.stages.map((stage) => (
          <li>
            <span>{stage.number}</span>
            <div><strong>{stage.verb}: {stage.title}</strong><p>{stage.output}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="content-section ink-band" {...fundingBlock}>
    <div class="shell funding-grid">
      <div data-reveal>
        <span class="eyebrow">{copy.fundingEyebrow}</span>
        <h2 class="section-title">{copy.fundingTitle}</h2>
        <p class="lead">{copy.fundingIntroduction}</p>
      </div>
      <div>
        {content.research.grants.map((grant, index) => (
          <article class="grant-mini" data-reveal data-reveal-delay={String(index)}>
            <span class="grant-agency">{grant.agency}<br />{grant.number}</span>
            <div><h3>{grant.title}</h3><p>{grant.principalInvestigator} · {grant.endDateLabel}: <time datetime={grant.endDateIso}>{grant.endDate}</time></p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section recent-work" {...publicationsBlock}>
    <div class="shell">
      <div class="recent-work-heading">
        <div data-reveal>
          <span class="eyebrow">{copy.publicationsEyebrow}</span>
          <h2 class="section-title">{copy.publicationsTitle}</h2>
        </div>
        <div data-reveal data-reveal-delay="1">
          <p class="lead">{copy.publicationsIntroduction}</p>
          <a class="text-link" href={pathFor(locale, 'publications')}>{copy.publicationsActionLabel}<span aria-hidden="true">→</span></a>
        </div>
      </div>

      <ol class="featured-publications" aria-label={copy.publicationsEyebrow}>
        {featuredPublications.map((publication, index) => (
          <li class="featured-publication" data-reveal data-reveal-delay={String(Math.min(index, 2))}>
            <span class="featured-publication-number">{String(index + 1).padStart(2, '0')}</span>
            <article>
              <div class="featured-publication-meta">
                <time datetime={publication.publication_date}>{publication.display_year_recommended}</time>
                <span>{publication.journal_or_source}</span>
              </div>
              <h3>
                <a href={preferredPublicationUrl(publication)} rel="external" aria-label={`${publication.title}. ${copy.publicationLinkLabel}`}>
                  {publication.title}<span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{publicationAuthors(publication.authors)}</p>
              <div class="featured-publication-evidence">
                {publication.oa_status !== 'closed' && <span>{copy.openAccessLabel}</span>}
                <span>
                  {publication.scholar_citations} {
                    publication.scholar_citations === 1
                      ? copy.singleCitationLabel
                      : copy.citationsLabel
                  }
                </span>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="content-section" {...teamBlock}>
    <div class="shell home-team-preview">
      <div class="portrait-pair" data-reveal>
        <figure><Image src={teamEstebanMedia.image} alt={copy.teamPortraitAlt.principalInvestigator || teamEstebanMedia.alt} widths={[360, 480, 720]} sizes="(max-width: 760px) 70vw, min(36vw, 360px)" quality={82} loading="lazy" decoding="async" style={`object-position: ${teamEstebanMedia.objectPosition}`} /></figure>
        <figure><Image src={teamSinayMedia.image} alt={copy.teamPortraitAlt.laboratoryCoordinator || teamSinayMedia.alt} widths={[280, 360, 599]} sizes="(max-width: 760px) 55vw, min(28vw, 280px)" quality={82} loading="lazy" decoding="async" style={`object-position: ${teamSinayMedia.objectPosition}`} /></figure>
      </div>
      <div data-reveal data-reveal-delay="1">
        <span class="eyebrow">{copy.teamEyebrow}</span>
        <h2 class="section-title">{copy.teamTitle}</h2>
        <p class="lead">{copy.teamIntroduction}</p>
        <a class="text-link" href={pathFor(locale, 'team')} style="margin-top: 30px" data-tina-field={editableField(copy, 'teamActionLabel')}>{copy.teamActionLabel}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="join-band scientific-contact" {...joinBlock}>
    <div class="shell join-inner">
      <div data-reveal>
        <span class="eyebrow">{copy.joinEyebrow}</span>
        <h2 class="section-title">{copy.joinTitle}</h2>
        <p>{copy.joinIntroduction}</p>
      </div>
      <a class="text-link" href={pathFor(locale, copy.joinAction.page)} data-reveal data-reveal-delay="1">{copy.joinAction.label}<span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<style>
  .hero-affiliation {
    display: flex;
    max-width: 620px;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(231, 245, 242, .28);
    color: rgba(238, 247, 245, .72);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero-affiliation span + span::before {
    content: '·';
    margin-right: 22px;
    color: var(--teal-soft);
  }

  .public-entry {
    padding-block: clamp(78px, 9vw, 124px);
    border-bottom: 1px solid var(--line-strong);
    background: var(--paper-2);
  }

  .public-entry-overview {
    display: grid;
    grid-template-columns: minmax(300px, .92fr) minmax(0, 1.08fr);
    gap: clamp(48px, 8vw, 118px);
    align-items: start;
  }

  .public-entry-heading h2 {
    max-width: 680px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 3.8vw, 4rem);
    font-weight: 650;
    letter-spacing: -.042em;
    line-height: 1.03;
    text-wrap: balance;
  }

  .public-entry-heading > p {
    max-width: 640px;
    margin: 30px 0 0;
    color: var(--ink-2);
    font-size: clamp(1.08rem, 1.45vw, 1.27rem);
    line-height: 1.58;
  }

  .public-entry-narrative > p {
    max-width: 730px;
    margin: 0;
    color: var(--ink-2);
    font-size: 1.04rem;
    line-height: 1.68;
  }

  .public-entry-narrative > p + p { margin-top: 18px; }

  .public-entry-question {
    display: grid;
    grid-template-columns: 158px minmax(0, 1fr);
    gap: clamp(18px, 3vw, 36px);
    margin-top: 40px;
    padding-block: 25px 27px;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .public-entry-question > span,
  .public-entry-register-label,
  .public-entry-scope > span,
  .public-entry-paths > p {
    color: var(--teal-dark);
    font-family: var(--font-data);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .045em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .public-entry-question > span { padding-top: 5px; }

  .public-entry-question > p {
    max-width: 650px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 620;
    letter-spacing: -.02em;
    line-height: 1.28;
    text-wrap: balance;
  }

  .public-entry-register {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr);
    margin-top: clamp(56px, 7vw, 86px);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .public-entry-concepts {
    padding: 30px clamp(34px, 5vw, 70px) 30px 0;
  }

  .public-entry-register-label { margin: 0 0 17px; }

  .public-entry-concepts dl { margin: 0; }

  .public-entry-concepts dl > div {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 26px;
    padding-block: 17px;
    border-top: 1px solid var(--line);
  }

  .public-entry-concepts dt {
    color: var(--ink);
    font-size: .94rem;
    font-weight: 680;
    line-height: 1.45;
  }

  .public-entry-concepts dd {
    max-width: 670px;
    margin: 0;
    color: var(--ink-2);
    font-size: .92rem;
    line-height: 1.55;
  }

  .public-entry-scope {
    padding: 32px clamp(28px, 4vw, 52px);
    border-left: 1px solid var(--line-strong);
    background: color-mix(in oklch, var(--teal) 5%, transparent);
  }

  .public-entry-scope > span { display: block; margin-bottom: 20px; }

  .public-entry-scope > p {
    margin: 0;
    color: var(--ink-2);
    font-size: .94rem;
    line-height: 1.62;
  }

  .public-entry-paths { margin-top: 32px; }

  .public-entry-paths > p { margin: 0 0 12px; }

  .public-entry-paths > div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .public-entry-paths .text-link {
    min-height: 68px;
    justify-content: space-between;
    padding: 14px clamp(16px, 2.2vw, 28px);
    transition: background-color 180ms ease;
  }

  .public-entry-paths .text-link + .text-link { border-left: 1px solid var(--line-strong); }

  .public-entry-paths .text-link:hover {
    background: color-mix(in oklch, var(--teal) 7%, transparent);
  }

  .recent-work {
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }

  .lab-image-register {
    padding-block: clamp(72px, 9vw, 126px);
    overflow: hidden;
    background: oklch(13.5% .022 226);
    color: oklch(96% .01 190);
  }

  .image-register-heading {
    display: grid;
    grid-template-columns: minmax(300px, .9fr) minmax(0, 1.1fr);
    gap: clamp(42px, 8vw, 120px);
    align-items: start;
    margin-bottom: clamp(48px, 7vw, 84px);
  }

  .image-register-index {
    margin-bottom: 26px;
    color: var(--teal-soft);
    font-family: var(--font-data);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .07em;
  }

  .image-register-heading h2 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 4.4rem);
    font-weight: 650;
    letter-spacing: -.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .image-register-context > p {
    max-width: 690px;
    margin-bottom: 30px;
    color: rgba(235, 246, 244, .78);
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    line-height: 1.55;
  }

  .image-register-context dl {
    margin: 0;
    border-top: 1px solid rgba(222, 240, 239, .22);
  }

  .image-register-context dl div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(222, 240, 239, .16);
  }

  .image-register-context dt {
    color: var(--teal-soft);
    font-size: .76rem;
    font-weight: 680;
  }

  .image-register-context dd {
    margin: 0;
    color: rgba(235, 246, 244, .72);
    font-size: .88rem;
    line-height: 1.45;
  }

  .image-register-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, .85fr);
    grid-template-rows: repeat(2, minmax(260px, 1fr));
    border: 1px solid rgba(222, 240, 239, .22);
    background: rgba(222, 240, 239, .22);
    gap: 1px;
  }

  .image-register-entry {
    display: grid;
    min-width: 0;
    grid-template-rows: minmax(0, 1fr) auto;
    margin: 0;
    background: oklch(13.5% .022 226);
  }

  .image-register-entry:first-child { grid-row: 1 / 3; }

  .image-register-media {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: oklch(6% .01 226);
  }

  .image-register-media :global(picture),
  .image-register-media :global(img) { width: 100%; height: 100%; }

  .image-register-media :global(img) {
    object-fit: cover;
    transition: transform 700ms cubic-bezier(.16, 1, .3, 1);
  }

  .image-register-entry:hover .image-register-media :global(img) { transform: scale(1.025); }

  .image-register-media > span {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 5px 7px;
    color: rgba(235, 246, 244, .86);
    background: rgba(2, 12, 18, .72);
    font-family: var(--font-data);
    font-size: .62rem;
    letter-spacing: .04em;
  }

  .image-register-entry figcaption {
    display: grid;
    grid-template-columns: minmax(120px, .45fr) minmax(0, 1fr);
    gap: 18px;
    padding: 16px 18px 17px;
