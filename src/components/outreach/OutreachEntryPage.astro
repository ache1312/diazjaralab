---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getContent, type Locale } from '@/content-data';
import {
  outreachEntryPath,
  type PublishedOutreachEntry,
} from '@/lib/outreach';
import { pathFor } from '@/lib/routes';
import { resolveMediaAsset } from '@/lib/media';

interface Props {
  locale: Locale;
  entry: PublishedOutreachEntry;
  translation?: PublishedOutreachEntry;
}

const { locale, entry, translation } = Astro.props;
const content = getContent(locale);
const coverMedia = entry.data.coverMedia
  ? resolveMediaAsset(entry.data.coverMedia, { locale, allowedKinds: ['micrograph', 'photograph', 'figure'] })
  : null;
if (coverMedia && coverMedia.type !== 'image') throw new Error(`La portada «${coverMedia.id}» no es una imagen.`);
const attachmentMedia = entry.data.attachmentMedia
  ? resolveMediaAsset(entry.data.attachmentMedia, { locale, allowedKinds: ['document'] })
  : null;
if (attachmentMedia && attachmentMedia.type !== 'document') throw new Error(`El adjunto «${attachmentMedia.id}» no es un documento.`);
const { Content } = await render(entry);
const canonicalPath = outreachEntryPath(locale, entry.data.slug);
const alternatePath = translation
  ? outreachEntryPath(translation.data.locale, translation.data.slug)
  : null;
const spanishPath = locale === 'es' ? canonicalPath : alternatePath;
const publishedDate = new Intl.DateTimeFormat(locale === 'es' ? 'es-CL' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(entry.data.publishedAt);
const updatedDate = new Intl.DateTimeFormat(locale === 'es' ? 'es-CL' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(entry.data.updatedAt);
const typeLabel = {
  article: content.outreach.archive.articleLabel,
  event: content.outreach.archive.eventLabel,
  resource: content.outreach.archive.resourceLabel,
}[entry.data.type];
const labels = content.outreach.entry;
const principalInvestigator = content.team.members.find((member) => member.id === 'esteban-diaz-jara');
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  inLanguage: locale,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  mainEntityOfPage: canonicalUrl.toString(),
  author: {
    '@type': 'Person',
    name: principalInvestigator?.name ?? content.brand.name,
  },
  publisher: {
    '@type': 'ResearchOrganization',
    name: content.brand.name,
  },
  ...(coverMedia || entry.data.cover
    ? { image: new URL(coverMedia?.url ?? entry.data.cover!, Astro.site ?? Astro.url).toString() }
    : {}),
};
---

<BaseLayout
  locale={locale}
  page="outreach"
  title={`${entry.data.title} | ${content.brand.name}`}
  description={entry.data.summary}
  structuredData={articleSchema}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  defaultAlternatePath={spanishPath ?? canonicalPath}
  ogType="article"
  content={content}
>
  <article>
    <header class="outreach-entry-hero">
      <div class="shell entry-hero-grid">
        <div data-reveal>
          <a class="entry-back" href={pathFor(locale, 'outreach')}><span aria-hidden="true">←</span>{labels.back}</a>
          <span class="eyebrow">{labels.section} · {typeLabel}</span>
          <h1 class="display-title">{entry.data.title}</h1>
          <p class="lead">{entry.data.summary}</p>
        </div>
        <dl class="entry-hero-meta" data-reveal data-reveal-delay="1">
          <div><dt>{labels.published}</dt><dd><time datetime={entry.data.publishedAt.toISOString()}>{publishedDate}</time></dd></div>
          <div><dt>{labels.updated}</dt><dd><time datetime={entry.data.updatedAt.toISOString()}>{updatedDate}</time></dd></div>
          <div><dt>{labels.language}</dt><dd>{labels.languageValue}</dd></div>
        </dl>
      </div>
    </header>

    {(coverMedia || entry.data.cover) && (
      <figure class="entry-cover shell" data-reveal>
        {coverMedia
          ? <Image src={coverMedia.image} alt={entry.data.coverAlt ?? coverMedia.alt ?? entry.data.title} widths={[720, 1100, 1600]} sizes="(max-width: 1200px) calc(100vw - 36px), 1160px" quality={82} style={`object-position: ${coverMedia.objectPosition}`} />
          : <img src={entry.data.cover!} alt={entry.data.coverAlt ?? entry.data.title} />}
        {coverMedia?.caption && <figcaption>{coverMedia.caption}</figcaption>}
      </figure>
    )}

    <section class="content-section entry-reading-section">
      <div class="shell entry-reading-grid">
        <aside class="entry-context" aria-label={labels.editorial} data-reveal>
          <span>{labels.editorial}</span>
          <p>{labels.editorialText}</p>
        </aside>
        <div class="entry-prose" data-reveal data-reveal-delay="1">
          <Content />
          {attachmentMedia && (
            <a class="entry-attachment" href={attachmentMedia.href} download>
              <span>{labels.attachmentLabel}</span>
              <small>PDF · {attachmentMedia.pageCount} {labels.pagesLabel}</small>
            </a>
          )}
        </div>
      </div>
    </section>

    <footer class="entry-next paper-band">
      <div class="shell entry-next-inner">
        <div>
          <span class="eyebrow">{labels.more}</span>
          <h2>{labels.research}</h2>
        </div>
        <div class="entry-next-actions">
          <a class="button" href={pathFor(locale, 'research')}>{labels.research}<span aria-hidden="true">→</span></a>
          <a class="button secondary" href={pathFor(locale, 'contact')}>{labels.contact}</a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .outreach-entry-hero {
    padding: clamp(58px, 7vw, 98px) 0 clamp(55px, 7vw, 92px);
    border-bottom: 1px solid var(--line);
  }

  .entry-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(240px, .45fr);
    gap: clamp(48px, 9vw, 120px);
    align-items: end;
  }

  .entry-back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(42px, 6vw, 72px);
    color: var(--ink-2);
    font-size: .9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .entry-back:hover { color: var(--teal-dark); }
  .entry-hero-grid .display-title { max-width: 900px; }
  .entry-hero-grid .lead { max-width: 760px; }

  .entry-hero-meta {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .entry-hero-meta div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 18px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }

  .entry-hero-meta dt {
    color: var(--teal-dark);
    font-size: .78rem;
    font-weight: 700;
  }

  .entry-hero-meta dd {
    margin: 0;
    color: var(--ink-2);
    font-size: .9rem;
  }

  .entry-cover {
    margin-top: clamp(42px, 6vw, 80px);
  }

  .entry-cover img {
    width: 100%;
    max-height: min(72vh, 760px);
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
  }

  .entry-cover figcaption {
    max-width: 90ch;
    margin-top: 10px;
    color: var(--ink-3);
    font-size: .76rem;
    line-height: 1.5;
  }

  .entry-reading-section { padding-top: clamp(64px, 8vw, 112px); }

  .entry-reading-grid {
    display: grid;
    grid-template-columns: minmax(150px, .38fr) minmax(0, 1fr);
    gap: clamp(48px, 9vw, 125px);
    align-items: start;
  }

  .entry-context {
    position: sticky;
    top: calc(var(--header-height) + 32px);
    padding-top: 16px;
    border-top: 1px solid var(--line-strong);
  }

  .entry-context span {
    display: block;
    margin-bottom: 9px;
    color: var(--teal-dark);
    font-size: .78rem;
    font-weight: 700;
  }

  .entry-context p {
    color: var(--ink-3);
    font-size: .88rem;
    line-height: 1.5;
  }

  .entry-prose {
    width: min(100%, 760px);
    color: var(--ink-2);
    font-size: clamp(1.05rem, 1.25vw, 1.16rem);
    line-height: 1.75;
  }

  .entry-prose :global(h2),
  .entry-prose :global(h3) {
    color: var(--ink);
    font-family: var(--font-body);
    letter-spacing: -.018em;
    line-height: 1.18;
  }

  .entry-prose :global(h2) {
    margin: 2.5em 0 .75em;
    padding-top: .75em;
    border-top: 1px solid var(--line);
    font-size: clamp(1.65rem, 2.4vw, 2.35rem);
  }

  .entry-prose :global(h3) { margin: 2em 0 .65em; font-size: 1.3rem; }
  .entry-prose :global(p) { margin-bottom: 1.35em; }
  .entry-prose :global(a) { color: var(--teal-dark); font-weight: 650; }
  .entry-prose :global(ul), .entry-prose :global(ol) { padding-left: 1.25em; }
  .entry-prose :global(li) { margin-bottom: .55em; padding-left: .25em; }
  .entry-prose :global(blockquote) {
    margin: 2em 0;
    padding: .3em 0 .3em 1.4em;
    border-left: 2px solid var(--teal-dark);
    color: var(--ink);
  }

  .entry-attachment {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding: 18px 0;
    border-block: 1px solid var(--line-strong);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .entry-attachment small { color: var(--ink-3); font-family: var(--font-mono); font-size: .7rem; font-weight: 600; }

  .entry-next { padding-block: clamp(58px, 7vw, 88px); }
  .entry-next-inner { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; }
  .entry-next h2 { margin: 0; font-size: clamp(1.75rem, 2.7vw, 2.7rem); letter-spacing: -.025em; line-height: 1.1; }
  .entry-next-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 860px) {
    .entry-hero-grid, .entry-reading-grid, .entry-next-inner { grid-template-columns: 1fr; }
    .entry-hero-meta { max-width: 520px; }
    .entry-context { position: static; max-width: 560px; }
  }

  @media (max-width: 560px) {
    .entry-next-actions { align-items: stretch; flex-direction: column; }
    .entry-next-actions .button { width: 100%; }
  }
</style>
