---
import PageView from '@/components/PageView.astro';
import type { Locale, PageId, SiteContent } from '@/content-data';

interface Props {
  locale: Locale;
  page: PageId;
  content: SiteContent;
}

const { locale, page, content } = Astro.props;
---

<PageView {locale} {page} {content} embedded />
