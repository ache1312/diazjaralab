---
import generatedNetwork from '@/content-data/publication-network.generated.json';
import type { Locale, SiteContent } from '@/content-data';
import { tinaField } from '@tinacms/astro/tina-field';
import {
  curatedTopicIdsByIdentity,
  isPublicationFeaturedByIdentity,
  isPublicationHiddenByIdentity,
  publicationFeaturedOrderByIdentity,
  publicationTopics,
} from '@/lib/publications';
import type { PublicationTopicId } from '@/lib/cms/models';

interface Props {
  locale: Locale;
  copy: SiteContent['publications']['network'];
}
interface PaperNode {
  id: string;
  kind: 'paper';
  listId: string;
  title: string;
  shortTitle: string;
  year: number;
  journal: string;
  authors: string[];
  citedByCount: number;
  doi: string | null;
  url: string;
  scholarUrl: string;
  openAlexId: string | null;
  topicIds: PublicationTopicId[];
  cluster: string;
  featured: boolean;
  featuredOrder: number;
  x: number;
  y: number;
}
interface ThemeNode {
  id: string;
  kind: 'theme';
  title: { es: string; en: string };
  topicId: PublicationTopicId;
  color: string;
  x: number;
  y: number;
}
interface NetworkEdge {
  source: string;
  target: string;
  kind: 'paper-similarity' | 'paper-theme';
  weight: number;
}
interface NetworkData {
  stats: { papers: number; themes: number; similarityEdges: number; themeEdges: number };
  nodes: Array<PaperNode | ThemeNode>;
  edges: NetworkEdge[];
}

const { locale, copy } = Astro.props;
const editableField = (field: string) => tinaField(copy as unknown as Record<string, unknown>, field) || undefined;
const sourceNetwork = generatedNetwork as unknown as NetworkData;
const sourceThemes = sourceNetwork.nodes.filter((node): node is ThemeNode => node.kind === 'theme');
const sourceNodesById = new Map(sourceNetwork.nodes.map((node) => [node.id, node]));
const themes = publicationTopics.map((topic) => {
  const source = sourceThemes.find((candidate) => candidate.topicId === topic.id);
  if (!source) throw new Error(`Missing graph node for required publication topic: ${topic.id}`);
  return { ...source, title: topic.label, color: topic.color, topicId: topic.id } satisfies ThemeNode;
});
const themeByTopicId = new Map(themes.map((theme) => [theme.topicId, theme]));
const papers = sourceNetwork.nodes
  .filter((node): node is PaperNode => node.kind === 'paper')
  .filter((paper) => !isPublicationHiddenByIdentity({ publicationId: paper.id, openAlexId: paper.openAlexId, doi: paper.doi }))
  .map((paper) => {
    const identity = { publicationId: paper.id, openAlexId: paper.openAlexId, doi: paper.doi };
    return {
      ...paper,
      topicIds: [...curatedTopicIdsByIdentity(identity, paper.topicIds)],
      featured: isPublicationFeaturedByIdentity(identity),
      featuredOrder: publicationFeaturedOrderByIdentity(identity),
    } satisfies PaperNode;
  });
const nodes = [...papers, ...themes];
const nodeById = new Map(nodes.map((node) => [node.id, node]));
const visibleNodeIds = new Set(nodes.map(({ id }) => id));
const similarityEdges = sourceNetwork.edges.filter((edge) =>
  edge.kind === 'paper-similarity'
  && visibleNodeIds.has(edge.source)
  && visibleNodeIds.has(edge.target),
);
const originalThemeEdgeWeights = new Map<string, number>();
for (const edge of sourceNetwork.edges) {
  if (edge.kind !== 'paper-theme') continue;
  const source = sourceNodesById.get(edge.source);
  const target = sourceNodesById.get(edge.target);
  const paperId = source?.kind === 'paper' ? source.id : target?.kind === 'paper' ? target.id : null;
  const topicId = source?.kind === 'theme' ? source.topicId : target?.kind === 'theme' ? target.topicId : null;
  if (paperId && topicId) originalThemeEdgeWeights.set(`${paperId}:${topicId}`, edge.weight);
}
const themeEdges: NetworkEdge[] = papers.flatMap((paper) => paper.topicIds.flatMap((topicId) => {
  const theme = themeByTopicId.get(topicId);
  return theme ? [{
    source: paper.id,
    target: theme.id,
    kind: 'paper-theme' as const,
    weight: originalThemeEdgeWeights.get(`${paper.id}:${topicId}`) ?? 4,
  }] : [];
}));
const edges = [...similarityEdges, ...themeEdges];
const networkStats = {
  papers: papers.length,
  themes: themes.length,
  similarityEdges: similarityEdges.length,
  themeEdges: themeEdges.length,
};
const featured = papers
  .filter((paper) => paper.featured)
  .sort((first, second) => first.featuredOrder - second.featuredOrder || second.year - first.year)
  .slice(0, 5);
const initial = featured[0] ?? papers[0]!;
if (!initial) throw new Error('The publication graph requires at least one visible paper.');

const labels = {
  ...copy,
  introduction: copy.introduction
    .replaceAll('{papers}', String(networkStats.papers))
    .replaceAll('{topics}', String(networkStats.themes)),
};

const localizedTitle = (node: PaperNode | ThemeNode) => node.kind === 'theme' ? node.title[locale] : node.title;
const localizedTopics = (paper: PaperNode) => paper.topicIds.map((topicId) => {
  const theme = themes.find((candidate) => candidate.topicId === topicId);
  return theme
    ? { id: theme.topicId, label: theme.title[locale], color: theme.color }
    : { id: topicId, label: topicId, color: '#60b8c3' };
});
const paperSize = (paper: PaperNode) => 10 + Math.min(10, Math.log10((paper.citedByCount ?? 0) + 1) * 5) + (paper.featured ? 5 : 0);
const nodeColor = (paper: PaperNode) => paper.year >= 2025 ? '#65d7c4' : paper.year >= 2022 ? '#2aa995' : '#24766f';
const similarityStrength = (edge: NetworkEdge) => (
  Math.min(10, Math.max(4, edge.weight)) - 4
) / 6;
const edgeWidth = (edge: NetworkEdge) => edge.kind === 'paper-theme'
  ? 2.15
  : 2.1 + similarityStrength(edge) * 2.5;
const edgeOpacity = (edge: NetworkEdge) => edge.kind === 'paper-theme'
  ? .28
  : .07 + similarityStrength(edge) * .12;
const edgePath = (edge: NetworkEdge) => {
  const source = nodeById.get(edge.source)!;
  const target = nodeById.get(edge.target)!;
  return `M ${source.x} ${source.y} L ${target.x} ${target.y}`;
};
const edgeColor = (edge: NetworkEdge) => {
  if (edge.kind !== 'paper-theme') return 'var(--teal-soft)';
  const source = nodeById.get(edge.source);
  const target = nodeById.get(edge.target);
  const theme = source?.kind === 'theme' ? source : target?.kind === 'theme' ? target : null;
  return theme?.color ?? 'var(--teal-soft)';
};
const connectedPapers = (nodeId: string) => edges
  .filter((edge) => edge.source === nodeId || edge.target === nodeId)
  .map((edge) => ({ edge, paper: nodeById.get(edge.source === nodeId ? edge.target : edge.source) }))
  .filter((entry): entry is { edge: NetworkEdge; paper: PaperNode } => entry.paper?.kind === 'paper')
  .sort((a, b) => b.edge.weight - a.edge.weight || b.paper.citedByCount - a.paper.citedByCount || b.paper.year - a.paper.year)
  .map((entry) => entry.paper)
  .slice(0, 6);
const initialConnections = connectedPapers(initial.id);
const clientData = {
  initialId: initial.id,
  labels,
  nodes: nodes.map((node) => node.kind === 'paper' ? {
    id: node.id,
    kind: node.kind,
    listId: node.listId,
    title: node.title,
    shortTitle: node.shortTitle,
    year: node.year,
    journal: node.journal,
    citedByCount: node.citedByCount,
    url: node.url,
    topics: localizedTopics(node),
    featured: node.featured,
    x: node.x,
    y: node.y,
  } : {
    id: node.id,
    kind: node.kind,
    title: node.title[locale],
    topicId: node.topicId,
    color: node.color,
    x: node.x,
    y: node.y,
  }),
  edges: edges.map(({ source, target, kind, weight }) => ({ source, target, kind, weight })),
};
const serializedClientData = JSON.stringify(clientData).replace(/</g, '\\u003c');
---

<section class="publication-network-section ink-band" data-publication-network>
  <div class="shell">
    <header class="network-heading">
      <div data-reveal>
        <span class="eyebrow" data-tina-field={editableField('eyebrow')}>{labels.eyebrow}</span>
        <h2 data-tina-field={editableField('title')}>{labels.title}</h2>
      </div>
      <div class="network-introduction" data-reveal data-reveal-delay="1">
        <p data-tina-field={editableField('introduction')}>{labels.introduction}</p>
        <dl class="network-stats" aria-label={labels.contentsLabel}>
          <div><dt>{labels.papers}</dt><dd>{networkStats.papers}</dd></div>
          <div><dt>{labels.themes}</dt><dd>{networkStats.themes}</dd></div>
        </dl>
      </div>
    </header>

    <div class="network-toolbar" data-reveal>
      <div class="network-focus">
        <p data-tina-field={editableField('focusLabel')}>{labels.focusLabel}</p>
        <div class="network-focus-scroll" role="group" aria-label={labels.focusLabel}>
          <button type="button" class="network-focus-button is-active" data-network-origin="all" aria-pressed="true">
            <span class="focus-dot" aria-hidden="true"></span>{labels.complete}
          </button>
          {featured.map((paper) => (
            <button type="button" class="network-focus-button" data-network-origin={paper.id} aria-pressed="false" title={paper.title}>
              <span class="focus-dot" aria-hidden="true"></span>{paper.shortTitle}
            </button>
          ))}
        </div>
      </div>
      <a class="network-export" href="/esteban-diaz-jara-publications.bib" download data-tina-field={editableField('export')}>{labels.export}<span aria-hidden="true">↓</span></a>
    </div>

    <div class="network-layout" data-reveal>
      <div class="network-canvas" role="group" aria-label={labels.graphLabel}>
        <svg class="network-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {edges.map((edge) => (
            <path
              d={edgePath(edge)}
              class:list={['network-edge', edge.kind === 'paper-theme' ? 'is-theme-edge' : 'is-paper-edge']}
              data-edge-source={edge.source}
              data-edge-target={edge.target}
              style={`--edge-weight:${edgeWidth(edge).toFixed(2)}px;--edge-opacity:${edgeOpacity(edge).toFixed(3)};--edge-color:${edgeColor(edge)}`}
            />
          ))}
        </svg>

        <span class="network-selection-indicator" data-network-indicator aria-hidden="true"></span>

        {nodes.map((node) => {
          const isPaper = node.kind === 'paper';
          const size = isPaper ? paperSize(node) : 15;
          const color = isPaper ? nodeColor(node) : node.color;
          const title = localizedTitle(node);
          const themeIndex = isPaper ? null : themes.findIndex((theme) => theme.id === node.id) + 1;
          const ariaLabel = isPaper
            ? `${labels.nodePaper}: ${title}, ${node.year}, ${node.citedByCount} ${labels.citations}`
            : `${labels.nodeTheme}: ${title}`;
          return (
            <button
              type="button"
              class:list={['network-node', isPaper ? 'is-paper-node' : 'is-theme-node', node.id === initial.id && 'is-active']}
              data-network-node={node.id}
              data-node-kind={node.kind}
              data-topic-id={!isPaper ? node.topicId : undefined}
              aria-label={ariaLabel}
              aria-pressed={node.id === initial.id ? 'true' : 'false'}
              style={`--node-x:${node.x}%;--node-x-narrow:${(((node.x - 4) / 92) * 100).toFixed(3)}%;--node-y:${node.y}%;--node-size:${size}px;--node-color:${color}`}
            >
              <span class="node-halo" aria-hidden="true"></span>
              <span class="node-visual" aria-hidden="true"></span>
              {!isPaper && (
                <span class:list={['node-label', node.x >= 50 ? 'is-left' : 'is-right']} aria-hidden="true">
                  <span class="node-label-index">{String(themeIndex).padStart(2, '0')}</span>
                  <span class="node-label-text">{title}</span>
                </span>
              )}
            </button>
          );
        })}
      </div>

      <aside class="network-detail" data-network-detail>
        <div class="network-detail-content" data-detail-content>
          <span class="detail-kind" data-detail-kind>{labels.selectedPaper}</span>
          <h3 data-detail-title tabindex="-1">{initial.title}</h3>
          <p class="detail-meta" data-detail-meta>{initial.journal} · {initial.year} · {initial.citedByCount} {labels.citations}</p>

          <p class="detail-theme-note" data-detail-theme-note hidden>{labels.themeNote}</p>

          <div class="detail-section" data-detail-topics-section>
            <h4>{labels.topicHeading}</h4>
            <ul class="detail-topics" data-detail-topics>
              {localizedTopics(initial).map((topic) => <li style={`--topic-color:${topic.color}`}>{topic.label}</li>)}
            </ul>
          </div>

          <div class="detail-section">
            <h4>{labels.connectedHeading} <span class="detail-connection-count" data-detail-connection-count>{initialConnections.length}</span></h4>
            <p class="detail-connection-order">{labels.connectionOrder}</p>
            <ol class="detail-connections" data-detail-connections>
              {initialConnections.map((paper, index) => (
                <li>
                  <button
                    type="button"
                    class="detail-connection-button"
                    data-connection-id={paper.id}
                    aria-label={`${labels.exploreConnection}: ${paper.year}, ${paper.title}`}
                    title={paper.title}
                  >
                    <span class="detail-connection-rank" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span class="detail-connection-copy">
                      <time datetime={String(paper.year)}>{paper.year}</time>
                      <strong>{paper.title}</strong>
                    </span>
                    <span class="detail-connection-action" aria-hidden="true">→</span>
                  </button>
                </li>
              ))}
            </ol>
            <p class="detail-empty" data-detail-empty hidden>{labels.noConnections}</p>
          </div>

          <div class="detail-links">
            <a href={initial.url} target="_blank" rel="noreferrer" data-detail-source>{labels.source}<span aria-hidden="true">↗</span></a>
            <a href={`#${initial.listId}`} data-detail-catalog data-network-catalog-link>{labels.catalogue}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </aside>
    </div>

    <p class="sr-only" aria-live="polite" aria-atomic="true" data-network-status>{labels.selectedPaper}: {initial.title}</p>

    <ul class="network-legend" aria-label={labels.legendLabel}>
      <li><i class="legend-paper" aria-hidden="true"></i>{labels.paperLegend}</li>
      <li><i class="legend-size" aria-hidden="true"></i>{labels.sizeLegend}</li>
      <li><i class="legend-recent" aria-hidden="true"></i>{labels.recentLegend}</li>
      <li><i class="legend-edge" aria-hidden="true"></i>{labels.relationLegend}</li>
      {publicationTopics.map((topic) => (
        <li><i class="legend-theme" style={`--topic-color:${topic.color}`} aria-hidden="true"></i>{topic.label[locale]}</li>
      ))}
    </ul>
    <p class="network-method" data-tina-field={editableField('method')}>{labels.method}</p>
  </div>
  <script type="application/json" data-network-data set:html={serializedClientData} is:inline></script>
</section>

<script>
  interface ClientTopic { id?: string; label: string; color: string }
  interface ClientNode {
    id: string;
    kind: 'paper' | 'theme';
    title: string;
    shortTitle?: string;
    year?: number;
    journal?: string;
    citedByCount?: number;
    url?: string;
    listId?: string;
    topics?: ClientTopic[];
    color?: string;
    x: number;
    y: number;
  }
  interface ClientEdge { source: string; target: string; kind: 'paper-similarity' | 'paper-theme'; weight: number }
  interface ClientLabels {
    selectedPaper: string;
    selectedTheme: string;
    citations: string;
    inferredTheme: string;
    themeNote: string;
    noConnections: string;
    connectionOrder: string;
    exploreConnection: string;
  }
  interface ClientData {
    initialId: string;
    labels: ClientLabels;
    nodes: ClientNode[];
    edges: ClientEdge[];
  }

  document.querySelectorAll<HTMLElement>('[data-publication-network]').forEach((root) => {
    if (root.dataset.networkReady === 'true') return;
    root.dataset.networkReady = 'true';
    const dataElement = root.querySelector<HTMLScriptElement>('[data-network-data]');
    if (!dataElement?.textContent) return;
    const data = JSON.parse(dataElement.textContent) as ClientData;
    const nodeData = new Map(data.nodes.map((node) => [node.id, node]));
    const nodeButtons = new Map(Array.from(root.querySelectorAll<HTMLButtonElement>('[data-network-node]')).map((button) => [button.dataset.networkNode!, button]));
    const edgeElements = Array.from(root.querySelectorAll<SVGPathElement>('[data-edge-source]'));
    const originButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-network-origin]'));
    const allOriginButton = originButtons.find((button) => button.dataset.networkOrigin === 'all');
    const detailKind = root.querySelector<HTMLElement>('[data-detail-kind]');
    const detailTitle = root.querySelector<HTMLElement>('[data-detail-title]');
    const detailMeta = root.querySelector<HTMLElement>('[data-detail-meta]');
    const detailContent = root.querySelector<HTMLElement>('[data-detail-content]');
    const detailTopics = root.querySelector<HTMLUListElement>('[data-detail-topics]');
    const detailTopicsSection = root.querySelector<HTMLElement>('[data-detail-topics-section]');
    const detailConnections = root.querySelector<HTMLElement>('[data-detail-connections]');
    const detailConnectionCount = root.querySelector<HTMLElement>('[data-detail-connection-count]');
    const detailEmpty = root.querySelector<HTMLElement>('[data-detail-empty]');
    const detailThemeNote = root.querySelector<HTMLElement>('[data-detail-theme-note]');
    const sourceLink = root.querySelector<HTMLAnchorElement>('[data-detail-source]');
    const catalogueLink = root.querySelector<HTMLAnchorElement>('[data-detail-catalog]');
    const networkStatus = root.querySelector<HTMLElement>('[data-network-status]');
    const canvas = root.querySelector<HTMLElement>('.network-canvas');
    const indicator = root.querySelector<HTMLElement>('[data-network-indicator]');
    const adjacency = new Map<string, Set<string>>();
    const paperAdjacency = new Map<string, Set<string>>();
    const edgeWeights = new Map<string, number>();
    const edgeKey = (left: string, right: string) => left < right ? `${left}::${right}` : `${right}::${left}`;
    for (const node of data.nodes) {
      adjacency.set(node.id, new Set());
      if (node.kind === 'paper') paperAdjacency.set(node.id, new Set());
    }
    for (const edge of data.edges) {
      adjacency.get(edge.source)?.add(edge.target);
      adjacency.get(edge.target)?.add(edge.source);
      edgeWeights.set(edgeKey(edge.source, edge.target), edge.weight);
      if (edge.kind === 'paper-similarity') {
        paperAdjacency.get(edge.source)?.add(edge.target);
        paperAdjacency.get(edge.target)?.add(edge.source);
      }
    }

    let activeId = data.initialId;
    let previewId: string | null = null;
    const originIds = new Set<string>();

    const connectedPaperNodes = (nodeId: string) => Array.from(adjacency.get(nodeId) ?? [])
      .map((id) => nodeData.get(id))
      .filter((node): node is ClientNode => node?.kind === 'paper')
      .sort((a, b) =>
        (edgeWeights.get(edgeKey(nodeId, b.id)) ?? 0) - (edgeWeights.get(edgeKey(nodeId, a.id)) ?? 0) ||
        (b.citedByCount ?? 0) - (a.citedByCount ?? 0) ||
        (b.year ?? 0) - (a.year ?? 0) ||
        a.title.localeCompare(b.title),
      );

    const animateDetail = () => {
      if (!detailContent) return;
      detailContent.classList.remove('is-updating');
      void detailContent.offsetWidth;
      detailContent.classList.add('is-updating');
    };

    const renderPanel = (nodeId: string, animate = true) => {
      const node = nodeData.get(nodeId);
      if (!node) return;
      const isPaper = node.kind === 'paper';
      if (detailKind) detailKind.textContent = isPaper ? data.labels.selectedPaper : data.labels.selectedTheme;
      if (detailTitle) detailTitle.textContent = node.title;
      if (detailMeta) detailMeta.textContent = isPaper
        ? [node.journal, node.year, `${node.citedByCount ?? 0} ${data.labels.citations}`].filter(Boolean).join(' · ')
        : data.labels.inferredTheme;
      if (detailTopics) {
        detailTopics.replaceChildren();
        const topics = isPaper
          ? (node.topics ?? [])
          : [{ label: node.title, color: node.color ?? '#60b8c3' }];
        for (const topic of topics) {
          const item = document.createElement('li');
          item.textContent = topic.label;
          item.style.setProperty('--topic-color', topic.color);
          detailTopics.append(item);
        }
      }
      if (detailTopicsSection) detailTopicsSection.hidden = !isPaper;
      if (detailConnections) {
        detailConnections.replaceChildren();
        const connections = connectedPaperNodes(nodeId).slice(0, 6);
        connections.forEach((paper, index) => {
          const item = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'detail-connection-button';
          button.dataset.connectionId = paper.id;
          button.setAttribute('aria-label', `${data.labels.exploreConnection}: ${paper.year ?? ''}, ${paper.title}`);
          button.title = paper.title;
          const rank = document.createElement('span');
          rank.className = 'detail-connection-rank';
          rank.ariaHidden = 'true';
          rank.textContent = String(index + 1).padStart(2, '0');
          const copy = document.createElement('span');
          copy.className = 'detail-connection-copy';
          const year = document.createElement('time');
          year.dateTime = String(paper.year ?? '');
          year.textContent = String(paper.year ?? '');
          const title = document.createElement('strong');
          title.textContent = paper.title;
          copy.append(year, title);
          const arrow = document.createElement('span');
          arrow.className = 'detail-connection-action';
          arrow.ariaHidden = 'true';
          arrow.textContent = '→';
          button.append(rank, copy, arrow);
          item.append(button);
          detailConnections.append(item);
        });
        if (detailConnectionCount) detailConnectionCount.textContent = String(connections.length);
        if (detailEmpty) detailEmpty.hidden = connections.length !== 0;
      }
      if (detailThemeNote) detailThemeNote.hidden = isPaper;
      if (sourceLink) {
        sourceLink.hidden = !isPaper;
        if (isPaper && node.url) sourceLink.href = node.url;
      }
      if (catalogueLink) {
        catalogueLink.hidden = !isPaper;
        if (isPaper && node.listId) catalogueLink.href = `#${node.listId}`;
      }
      root.dataset.networkDetailKind = node.kind;
      if (animate) animateDetail();
    };

    const intersectSets = (left: Set<string>, right: Set<string>) => {
      const result = new Set<string>();
      left.forEach((id) => { if (right.has(id)) result.add(id); });
      return result;
    };

    const visiblePaperIds = () => {
      const allPapers = data.nodes.filter((node) => node.kind === 'paper').map((node) => node.id);
      if (!originIds.size) return new Set(allPapers);
      let visible: Set<string> | null = null;
      for (const originId of originIds) {
        const related = new Set([originId, ...(paperAdjacency.get(originId) ?? [])]);
        visible = visible === null ? related : intersectSets(visible, related);
      }
      return visible ?? new Set(allPapers);
    };

    const positionIndicator = (nodeId: string) => {
      const node = nodeData.get(nodeId);
      const button = nodeButtons.get(nodeId);
      if (!node || !button || !canvas || !indicator) return;
      const canvasRect = canvas.getBoundingClientRect();
      const buttonRect = button.getBoundingClientRect();
      const x = buttonRect.left + buttonRect.width / 2 - canvasRect.left - canvas.clientLeft;
      const y = buttonRect.top + buttonRect.height / 2 - canvasRect.top - canvas.clientTop;
      indicator.style.setProperty('--indicator-color', button.style.getPropertyValue('--node-color'));
      indicator.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      indicator.classList.add('is-ready');
      indicator.classList.toggle('is-preview', previewId !== null);
    };

    const updateGraph = () => {
      const visiblePapers = visiblePaperIds();
      const visibleThemes = new Set<string>();
      for (const edge of data.edges) {
        if (edge.kind !== 'paper-theme') continue;
        const paperId = nodeData.get(edge.source)?.kind === 'paper' ? edge.source : edge.target;
        const themeId = paperId === edge.source ? edge.target : edge.source;
        if (visiblePapers.has(paperId)) visibleThemes.add(themeId);
      }
      const focusId = previewId ?? activeId;
      const focusNeighbours = adjacency.get(focusId) ?? new Set<string>();
      canvas?.classList.toggle('has-preview', previewId !== null);
      for (const [id, button] of nodeButtons) {
        const node = nodeData.get(id);
        const isVisible = node?.kind === 'paper' ? visiblePapers.has(id) : visibleThemes.has(id);
        const isFocus = id === focusId;
        const isNeighbour = focusNeighbours.has(id);
        button.classList.toggle('is-filtered', !isVisible);
        button.classList.toggle('is-muted', isVisible && !isFocus && !isNeighbour);
        button.classList.toggle('is-neighbour', isVisible && isNeighbour);
        button.classList.toggle('is-active', id === activeId);
        button.classList.toggle('is-preview', id === previewId);
        button.setAttribute('aria-pressed', String(id === activeId));
      }
      root.querySelectorAll<HTMLButtonElement>('[data-connection-id]').forEach((button) => {
        button.classList.toggle('is-preview', button.dataset.connectionId === previewId);
      });
      for (const edge of edgeElements) {
        const source = edge.dataset.edgeSource!;
        const target = edge.dataset.edgeTarget!;
        const sourceNode = nodeData.get(source);
        const targetNode = nodeData.get(target);
        const sourceVisible = sourceNode?.kind === 'paper' ? visiblePapers.has(source) : visibleThemes.has(source);
        const targetVisible = targetNode?.kind === 'paper' ? visiblePapers.has(target) : visibleThemes.has(target);
        const touchesFocus = source === focusId || target === focusId;
        edge.classList.toggle('is-filtered', !(sourceVisible && targetVisible));
        edge.classList.toggle('is-active', touchesFocus && previewId === null);
        edge.classList.toggle('is-preview', touchesFocus && previewId !== null);
      }
      const complete = originIds.size === 0;
      allOriginButton?.classList.toggle('is-active', complete);
      allOriginButton?.setAttribute('aria-pressed', String(complete));
      for (const button of originButtons) {
        const id = button.dataset.networkOrigin;
        if (!id || id === 'all') continue;
        const selected = originIds.has(id);
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-pressed', String(selected));
      }
      positionIndicator(focusId);
    };

    function selectNode(nodeId: string, focusDetail = false) {
      const node = nodeData.get(nodeId);
      if (!node) return;
      activeId = nodeId;
      previewId = null;
      renderPanel(nodeId);
      updateGraph();
      if (networkStatus) {
        const kind = node.kind === 'paper' ? data.labels.selectedPaper : data.labels.selectedTheme;
        networkStatus.textContent = `${kind}: ${node.title}`;
      }
      if (focusDetail) detailTitle?.focus({ preventScroll: true });
    }

    function previewNode(nodeId: string, updatePanel: boolean) {
      if (!nodeData.has(nodeId) || nodeId === activeId) return;
      previewId = nodeId;
      if (updatePanel) renderPanel(nodeId, false);
      updateGraph();
    }

    function clearPreview(nodeId: string, restorePanel: boolean) {
      if (previewId !== nodeId) return;
      previewId = null;
      if (restorePanel) renderPanel(activeId, false);
      updateGraph();
    }

    for (const [id, button] of nodeButtons) {
      button.addEventListener('click', () => selectNode(id));
      button.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'touch') previewNode(id, true);
      });
      button.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'touch') clearPreview(id, true);
      });
      button.addEventListener('focus', () => previewNode(id, true));
      button.addEventListener('blur', () => clearPreview(id, true));
    }
    for (const button of originButtons) {
      button.addEventListener('click', () => {
        const id = button.dataset.networkOrigin;
        if (!id || id === 'all') {
          originIds.clear();
        } else {
          if (originIds.has(id)) originIds.delete(id);
          else originIds.add(id);
          selectNode(id);
        }
        updateGraph();
      });
    }
    detailConnections?.addEventListener('pointerover', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-connection-id]');
      const related = event.relatedTarget;
      if (!button || (related instanceof Node && button.contains(related))) return;
      if (event.pointerType !== 'touch') previewNode(button.dataset.connectionId!, false);
    });
    detailConnections?.addEventListener('pointerout', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-connection-id]');
      const related = event.relatedTarget;
      if (!button || (related instanceof Node && button.contains(related))) return;
      if (event.pointerType !== 'touch') clearPreview(button.dataset.connectionId!, false);
    });
    detailConnections?.addEventListener('focusin', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-connection-id]');
      if (button) previewNode(button.dataset.connectionId!, false);
    });
    detailConnections?.addEventListener('focusout', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-connection-id]');
      if (button) clearPreview(button.dataset.connectionId!, false);
    });
    detailConnections?.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-connection-id]');
      if (button) selectNode(button.dataset.connectionId!, true);
    });
    catalogueLink?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('publication:show-articles')));
    if (canvas && 'ResizeObserver' in window) {
      new ResizeObserver(() => positionIndicator(previewId ?? activeId)).observe(canvas);
    }
    updateGraph();
  });
</script>

